    "guided.createNow.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the + button in the bottom right to record your first moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右下角的 + 按钮，记录你的第一个时刻吧。"
          }
        }
      }
    },
    "guided.createNow.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马上创建"
          }
        }
      }
    },
    "guided.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your personal timeline — every entry carries the mood, tags, and photos from that moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是你的个人时间轴，每一条记录都带着当时的心情、标签与照片。"
          }
        }
      }
    },
    "guided.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Moments~"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎来到时刻~"
          }
        }
      }
    },
    "guided.whatIsMoment.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Moment is a life memory with an emotional identity, placed on your personal timeline where you can look back, filter, and organize it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时刻是一条带情绪身份的生活记忆，挂在可回看、可筛选、可整理的个人时间轴上。"
          }
        }
      }
    },
    "guided.whatIsMoment.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is a Moment?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是时刻?"
          }
        }
      }
    },
